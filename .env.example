# AI
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# GitHub
GITHUB_TOKEN=your_github_token_here

# Product Hunt
PRODUCTHUNT_API_KEY=your_producthunt_api_key_here
PRODUCTHUNT_API_SECRET=your_producthunt_api_secret_here

# Web app
APP_VERSION=1.0.0
BUILD_DATE=01 Jan 2026
APP_COMMIT=
FLASK_DEBUG=0
PORT=5000

# Scheduler
SCHEDULER_ENABLED=True
SCHEDULER_TIME=07:00
SCHEDULER_TIMEZONE=Europe/Rome
SCHEDULER_CHECK_SECONDS=30
SCHEDULER_CATCH_UP=True

# Runtime / deployment
RUNTIME_ROLE=web
SCHEDULER_IN_PROCESS=False

# Production database
# Set this in the cloud to the managed PostgreSQL connection string.
# Production example:
# DATABASE_URL=postgresql://user:password@host:5432/cash_machine_engine
# DB_BACKEND=postgres

# Local development can omit DATABASE_URL and use SQLite.
CASH_MACHINE_DB_PATH=database/opportunities.db
DB_BACKEND=sqlite
